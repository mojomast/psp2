{
  "$GMObject":"",
  "%Name":"obj_idle_controller",
  "eventList":[
    {"$GMEvent":"","%Name":"","collisionObjectId":null,"eventNum":0,"eventType":0,"isDnD":false,"name":"","resourceType":"GMEvent","resourceVersion":"2.0","gmEvent":{"$GMEvent":"","%Name":"","collisionObjectId":null,"eventNum":0,"eventType":0,"isDnD":false,"name":"","resourceType":"GMEvent","resourceVersion":"2.0","script":"// Create Event - Initialize game and run tests\nshow_debug_message(\"=== IDLE GAME INITIALIZING ===\");\n\n// Initialize global variables\ninit_game_state();\n\n// Run all tests\nshow_debug_message(\"=== RUNNING TESTS ===\");\nvar _test_results = run_all_tests();\n\nshow_debug_message(\"=== GAME READY ===\");\nshow_debug_message(\"Press T to run tests manually\");\nshow_debug_message(\"Press R to reset game state\");\n"}},
    {"$GMEvent":"","%Name":"","collisionObjectId":null,"eventNum":0,"eventType":3,"isDnD":false,"name":"","resourceType":"GMEvent","resourceVersion":"2.0","gmEvent":{"$GMEvent":"","%Name":"","collisionObjectId":null,"eventNum":0,"eventType":3,"isDnD":false,"name":"","resourceType":"GMEvent","resourceVersion":"2.0","script":"// Step Event - Handle input and update game state\n\n// Manual test runner\nif (keyboard_check_pressed(ord(\"T\"))) {\n    show_debug_message(\"=== MANUAL TEST RUN ===\");\n    run_all_tests();\n}\n\n// Reset game state\nif (keyboard_check_pressed(ord(\"R\"))) {\n    show_debug_message(\"=== RESETTING GAME STATE ===\");\n    file_delete(\"savegame.json\");\n    game_restart();\n}\n\n// Update game state (idle mechanics)\nupdate_game_state();"}},
    {"$GMEvent":"","%Name":"","collisionObjectId":null,"eventNum":0,"eventType":8,"isDnD":false,"name":"","resourceType":"GMEvent","resourceVersion":"2.0","gmEvent":{"$GMEvent":"","%Name":"","collisionObjectId":null,"eventNum":0,"eventType":8,"isDnD":false,"name":"","resourceType":"GMEvent","resourceVersion":"2.0","script":"// Draw Event - Show game status\ndraw_set_color(c_white);\ndraw_set_font(-1);\n\ndraw_text(10, 10, \"Idle Incremental Game - PSP\");\ndraw_text(10, 30, \"Gold: \" + string(global.resources.gold));\ndraw_text(10, 50, \"Wood: \" + string(global.resources.wood));\ndraw_text(10, 70, \"Metal: \" + string(global.resources.metal));\ndraw_text(10, 90, \"Gems: \" + string(global.resources.gems));\n\ndraw_text(10, 120, \"Player: \" + global.player_name);\ndraw_text(10, 140, \"Level: \" + string(global.player_level));\ndraw_text(10, 160, \"Pets: \" + string(array_length(global.pets)));\n\ndraw_text(10, 190, \"Press T: Run Tests\");\ndraw_text(10, 210, \"Press R: Reset Game\");\ndraw_text(10, 230, \"Check Debug Console for test results!\");"}},
